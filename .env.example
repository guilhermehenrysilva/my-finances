# Copie para .env e preencha. O .env nunca deve ir para o git.

# Credenciais da aplicação em https://dashboard.pluggy.ai (aba "Aplicação")
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Porta no seu computador (http://localhost:47815)
APP_PORT=47815

# Porta do endereço sem número (http://financeiro.localhost). Troque se outro projeto precisar da 80.
APP_HTTP_PORT=80

# Primeira sincronização busca quantos dias para trás
SYNC_DAYS_BACK=90

# Intervalo entre sincronizações automáticas (a Pluggy atualiza os dados 1x por dia)
SYNC_INTERVAL_HOURS=6
